# Copy this file to ".env" and fill in your own keys. ".env" is never committed.
ALPACA_API_KEY=
ALPACA_API_SECRET=
FINNHUB_API_KEY=

# Supabase (database and login). The secret key is powerful: never share it.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Notifications. The two VAPID keys are a matching pair that prove a push came
# from this app. The private one is secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional extras
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HEARTBEAT_URL=
